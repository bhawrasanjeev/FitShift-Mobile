# FitShift Android Mobile Application - Environment Variables Template
# Copy this file to .env or configure via mobile runtime settings

# API Base URL Options:
# Android Emulator (points to host localhost):
API_BASE_URL=http://10.0.2.2:5001

# Android Emulator Alternative (standard Express port 5000):
# API_BASE_URL=http://10.0.2.2:5000

# Physical Device on same Wi-Fi (replace with your machine's LAN IP):
# API_BASE_URL=http://192.168.1.100:5001

# Production Deployed HTTPS Backend:
# API_BASE_URL=https://api.fitshift.app

# Timeout Configurations (in milliseconds)
API_TIMEOUT_MS=12000
AI_TIMEOUT_MS=30000
