# FitShift Android Release Signing Configuration Example
# Copy this file to android/keystore.properties and fill with your actual keystore details.
# DO NOT commit android/keystore.properties to version control.

FITSHIFT_RELEASE_STORE_FILE=release.keystore
FITSHIFT_RELEASE_STORE_PASSWORD=your_store_password
FITSHIFT_RELEASE_KEY_ALIAS=fitshift-release
FITSHIFT_RELEASE_KEY_PASSWORD=your_key_password
